# Optional development overrides. Copy to .env.local if needed.
# Never put model, Apple, GitHub, or MCP credentials in this file.
# Configure model/MCP secrets through the app so Main can encrypt them with safeStorage.

# Isolate all Electron application data for development or destructive tests.
AEVOREN_BOT_USER_DATA_DIR=

# Override only the SQLite path. Prefer USER_DATA_DIR for complete isolation.
AEVOREN_BOT_DB_PATH=

# Deterministic development Provider; no external account or API key required.
AEVOREN_BOT_FAKE_PROVIDER=0

# Optional Jev Shadow Mode. It records routing/tool suggestions without changing behavior.
# Keep the API key in the process environment only; never commit it to this file.
AEVOREN_DECISION_SHADOW=0
AEVOREN_JEV_API_KEY=
AEVOREN_JEV_MODEL=jev-1.13.0

# Emergency switch. Unpackaged development builds are disabled automatically.
AEVOREN_BOT_DISABLE_UPDATES=0
