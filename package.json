{
  "name": "aevoren-bot",
  "productName": "Aevoren Bot",
  "version": "0.2.0-beta.6",
  "license": "Apache-2.0",
  "private": true,
  "description": "Aevoren Bot is a reliable local desktop workspace for persistent AI bots.",
  "repository": {
    "type": "git",
    "url": "https://github.com/CMSKL/Aevoren-Bot.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "pnpm build && playwright test",
    "package:mac": "pnpm build && electron-builder --config build/electron-builder.config.cjs --mac --arm64 --dir --publish never",
    "release:mac": "pnpm build && electron-builder --config build/electron-builder.config.cjs --mac --arm64 --publish never",
    "release:finalize:mac": "node scripts/finalize-notarized-macos-release.mjs dist",
    "release:prepare": "node scripts/verify-macos-release-assets.mjs dist",
    "release:verify": "node scripts/verify-release-version.mjs",
    "diagnostics:room": "node scripts/room-diagnostics.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "7.7.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "app-builder-lib": "26.15.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  }
}
