{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "paths": { "@shared/*": ["./src/shared/*"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client", "electron", "node"]
  },
  "include": ["src/media-parser/**/*.ts", "src/shared/media-parser-protocol.ts", "media-parser.vite.config.ts"]
}
