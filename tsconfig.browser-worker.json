{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "paths": { "@shared/*": ["./src/shared/*"] }, "strict": true,
    "noUncheckedIndexedAccess": true, "types": ["node", "vitest/globals"],
    "skipLibCheck": true, "noEmit": true
  },
  "include": ["src/browser-worker/**/*.ts", "browser-worker.vite.config.ts"]
}
